# DOCSHIELD AI — environment template
# Copy to .env and adjust. Never commit real secrets.

DOCSHIELD_ENV=development
DOCSHIELD_DEBUG=true
DOCSHIELD_HOST=127.0.0.1
DOCSHIELD_PORT=8000

# Storage
DOCSHIELD_DATA_DIR=data
DOCSHIELD_UPLOAD_DIR=data/uploads
DOCSHIELD_TEMP_DIR=data/temp
DOCSHIELD_DB_URL=sqlite:///./data/docshield.db

# Upload limits
DOCSHIELD_MAX_UPLOAD_BYTES=10485760
DOCSHIELD_MAX_IMAGE_PIXELS=40000000
DOCSHIELD_ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.webp,.pdf
DOCSHIELD_ALLOW_PDF=true
DOCSHIELD_RETAIN_UPLOADS=false
DOCSHIELD_UPLOAD_TTL_SECONDS=3600
DOCSHIELD_RATE_LIMIT_PER_MINUTE=30

# Demo
DOCSHIELD_DEMO_MODE=true

# ML: auto | real | mock (mock skips weight downloads — used in tests)
DOCSHIELD_ML_MODE=auto
DOCSHIELD_FORCE_CPU=false

# Optional API key for mutating endpoints (leave empty to disable in local demo)
DOCSHIELD_API_KEY=

# Official verification / reverse search providers (disabled by default)
DOCSHIELD_OFFICIAL_VERIFY_URL=
DOCSHIELD_REVERSE_SEARCH_URL=
